# Seguridad y configuración de la app
# (No expongas credenciales en el repositorio)

# Evitar listado de directorios
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Bloquear acceso a archivos/paths que comienzan con punto (.git, .env, etc.)
  RewriteRule "(^|/)\." - [F]

  # Bloquear acceso directo a la carpeta sql/
  RewriteRule ^sql/ - [F,L]

  # Nunca servir credenciales ni herramientas de diagnóstico, aunque se suban por error.
  RewriteRule ^app/env\.php$ - [F,L,NC]
  RewriteRule ^test/diagnostico\.php$ - [F,L,NC]
  RewriteRule ^(?:version|phpinfo)\.php$ - [F,L,NC]

  # Forzar HTTPS (si hay SSL activo en el hosting) excepto en localhost
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# MIME para Web App Manifest
AddType application/manifest+json .webmanifest

# Variables de entorno para conexión a BD (solo en producción)
# Descomenta y rellena en el servidor (no subas secretos al repo)
# SetEnv DB_HOST sqlXXX.epizy.com
# SetEnv DB_USER epiz_12345678
# SetEnv DB_PASS TU_PASSWORD_AQUI
# SetEnv DB_NAME epiz_12345678_gasolina
